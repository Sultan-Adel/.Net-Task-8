@model SchoolSystem.ViewModels.StudentListViewModel

@{
    ViewData["Title"] = "Students (with AJAX Live Search)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Students</h2>
    <a asp-controller="Student" asp-action="Add" class="btn btn-success">+ Add Student</a>
</div>

<!-- AJAX Live Search Box (Simple Demo) -->
<div class="card mb-4">
    <div class="card-body">
        <label for="ajaxSearchInput" class="form-label fw-bold">AJAX Live Search by Student Name</label>
        <input type="text" id="ajaxSearchInput" class="form-control" placeholder="Type a student name to search via AJAX..." />
        <div id="ajaxStatus" class="form-text text-muted mt-1"></div>
        <div id="ajaxResultsContainer" class="mt-3"></div>
    </div>
</div>

<!-- Server-side Filter & Search Form -->
<form asp-controller="Student" asp-action="GetAll" method="get" class="row g-3 mb-4">
    <div class="col-md-5">
        <input type="text" name="searchName" value="@Model.SearchName" class="form-control" placeholder="Search by name..." />
    </div>
    <div class="col-md-4">
        <select name="departmentId" asp-items="Model.Departments" class="form-select">
            <option value="">-- All Departments --</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-controller="Student" asp-action="GetAll" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Students)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.Age</td>
                <td>@s.Department?.Name</td>
                <td class="d-flex gap-1">
                    <a asp-controller="Student" asp-action="ShowDetails" asp-route-id="@s.Id" class="btn btn-sm btn-info text-white">Details</a>
                    <a asp-controller="Student" asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-controller="Student" asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.getElementById("ajaxSearchInput").addEventListener("input", async function () {
            const term = this.value.trim();
            const statusEl = document.getElementById("ajaxStatus");
            const container = document.getElementById("ajaxResultsContainer");

            if (!term) {
                statusEl.textContent = "";
                container.innerHTML = "";
                return;
            }

            statusEl.textContent = "Searching...";
            try {
                const response = await fetch(`/Student/AjaxSearch?name=${encodeURIComponent(term)}`);
                if (!response.ok) throw new Error("Network response was not ok");
                const data = await response.json();

                statusEl.textContent = `Found ${data.length} matching student(s).`;
                if (data.length === 0) {
                    container.innerHTML = `<div class="alert alert-light border">No matching students found.</div>`;
                    return;
                }

                let rows = data.map(item => `
                    <tr>
                        <td>${item.id}</td>
                        <td>${item.name}</td>
                        <td>${item.age}</td>
                        <td>${item.departmentName}</td>
                    </tr>
                `).join("");

                container.innerHTML = `
                    <table class="table table-sm table-bordered bg-white">
                        <thead class="table-secondary">
                            <tr><th>Id</th><th>Name</th><th>Age</th><th>Department</th></tr>
                        </thead>
                        <tbody>${rows}</tbody>
                    </table>`;
            } catch (err) {
                statusEl.textContent = "Error fetching AJAX results.";
            }
        });
    </script>
}
