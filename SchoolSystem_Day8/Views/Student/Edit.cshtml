@model SchoolSystem.ViewModels.StudentFormViewModel

@{
    ViewData["Title"] = "Edit Student";
}

<h2>Edit Student</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Age" class="form-label"></label>
        <input asp-for="Age" type="number" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DepartmentId" class="form-label"></label>
        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select"></select>
    </div>
    <button type="submit" class="btn btn-warning">Update</button>
</form>
